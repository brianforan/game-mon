# Copy this file to .env (same folder) and fill in the values.
# .env is read when the app starts; restart the app after editing it.
# Never share .env or paste its contents anywhere.

# Elasticsearch endpoint: Kibana > ? (Help) > Connection details > Endpoints > Elasticsearch
ELASTIC_URL=https://your-deployment.es.us-east-1.aws.found.io

# Encoded API key: Kibana > ? (Help) > Connection details > API key
ELASTIC_API_KEY=

# Optional: Anthropic API key for the process labels
ANTHROPIC_API_KEY=
